# Copy this file to `.env` and fill in the values.

# A long random string used to sign login cookies (JWT).
JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth credentials — create them at https://console.cloud.google.com
#   APIs & Services -> Credentials -> Create OAuth client ID -> Web application
#   Authorized redirect URI (Docker):  http://localhost:8080/api/auth/google/callback
#   Authorized redirect URI (local dev): http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser-facing frontend URL and the OAuth callback (defaults match Docker setup).
CLIENT_URL=http://localhost:8080
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# Comma-separated list of admin emails (these Google accounts become admins).
ADMIN_EMAILS=erik.macejko@gmail.com

# Minutes before kickoff when betting locks and other players' tips are revealed.
LOCK_MINUTES=30
